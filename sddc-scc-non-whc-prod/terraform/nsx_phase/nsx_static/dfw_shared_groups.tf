resource "nsxt_policy_group" "wh_any" {
  lifecycle {
    create_before_destroy = true
  }
  display_name = "wh_any"
  description  = "role: wh_any, ip: [0.0.0.0/0]"
  domain       = "cgw"
  criteria {
    ipaddress_expression {
      ip_addresses = ["0.0.0.0/0"]
    }
  }
}
