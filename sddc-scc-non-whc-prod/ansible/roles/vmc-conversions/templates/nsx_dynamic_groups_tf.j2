/*========================================

###########################################################################
###########################################################################
###                                                                     ###
{% if policy.policy == 'dynamic' %}
###               {{ policy.policy |upper }} GROUPS - NOT MIGRATED FROM SCC                ###
{% elif policy.policy == 'global' %}
###                {{ policy.policy |upper }} GROUPS - NOT MIGRATED FROM SCC                ###
{% elif policy.policy == 'intra-segment' %}
###             {{ policy.policy |upper }} GROUPS - NOT MIGRATED FROM SCC            ###
{% endif %}
###                                                                     ###
###########################################################################
###########################################################################

========================================*/

{% for resource in resources.group_objects %}
resource "nsxt_policy_group" "{{ resource.group_name |lower | regex_replace (" ","_") }}" {
  lifecycle {
    create_before_destroy = true
  }
  display_name = "{{ resource.group_name |lower | regex_replace (" ","_") }}"
  description  = "role: {{ resource.description }}{% if ("role: ",resource.description,", ip: ", resource.ip_addr_list |join(", ")) |join("") |length < 1010 %}, ip: [{% for ip in resource.ip_addr_list %}{% if loop.last %}{{ ip }}{% else %}{{ ip }}, {% endif %}{% endfor %}]{% else %}, range: [{{ resource.ip_addr_list | first }}-{{ resource.ip_addr_list | last }}]{% endif %}"
  domain       = "cgw"
  criteria {
    ipaddress_expression {
      ip_addresses = [{% for ip in resource.ip_addr_list %}{% if loop.last %}"{{ ip }}"{% else %}"{{ ip }}", {% endif %}{% endfor %}]
    }
  }
}
{% endfor %}

/*======================================
#### object-groups ####
========================================*/

{% for resource in resources.object_groups %}
{% if resource.sub_group_list is iterable %}
resource "nsxt_policy_group" "{{ resource.group_name |lower | regex_replace (" ","_") }}" {
  lifecycle {
    create_before_destroy = true
  }
  display_name = "{{ resource.group_name |lower | regex_replace (" ","_") }}"
  description  = "role: {{ resource.description }}"
  domain       = "cgw"
  criteria {
    path_expression {
      member_paths = [{% for object in resource.sub_group_list %}{% if loop.last %}nsxt_policy_group.{{ object }}.path{% else %}nsxt_policy_group.{{ object }}.path, {% endif %}{% endfor %}]
    }
  }
}
{% endif %}
{% endfor %}