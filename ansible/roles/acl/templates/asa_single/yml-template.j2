---
{# If this is not a RAS deployment it will produce YML data for all access group #}
{% if ras_cfg is not defined or ras_cfg != 'deploy' %}
access_groups:
{%  if access_group_facts and access_group_facts %}
{%   for item in access_group_facts %}

{%     if item.direction == 'global' %}
  - interface: global
    access_list: {{ item.access_list }}
    direction: in
{%     else%}
  - interface: {{ item.interface }}
    access_list: {{ item.access_list }}
    direction: {{ item.direction }}
{%     endif %}
{%   endfor %}
{%  endif %}
{% else %}
{% for item in ras_filters_facts -%}
{%  if item.acl_name == loop_acl and ras_cfg is defined and ras_cfg == 'deploy' %}
ra_vpn_filters_{{ item.acl_name | replace ("-","_") | regex_search ('\S+(?=_)|\S+') }}_filter:

  - group_policy: {{ item.policy_name }}
    ra_vpn_filter: {{ item.acl_name }}
{#    split_tunnel_filter: {{ item.split_tunnel_acl }} # This is to be deployed in the future #}
    
{%  endif -%}
{% endfor -%}
{% endif %}

{# If this produce the key for the access list, if this is RAS then it is the name of the access list (excluding the version and - replaced with _ i.e. ras_general_filter ) if not then
then it is just access_list #}
{% for acl in access_lists -%}
{%  if ras_cfg is defined and ras_cfg == 'deploy' and acl.item.item == loop_acl %}
{{ (acl.item.item | replace ("-","_") | regex_search ('\S+(?=_)|\S+')) }}:

{%  elif  ras_cfg is not defined or ras_cfg != 'deploy' -%}
access_lists:

{%  endif -%}

{# This is to produce the YML for the access lists. If this is for RAS, it will only produce ACL from the ACL Name that has been passed to via the loop_acl varible form the ansible role.
This will also stip any version numbers from the Name of the ACL #}
{% if ras_cfg is not defined or (acl.item.item == loop_acl and ras_cfg == "deploy") %}
  - name: "{{ acl.item.item | regex_search ('\S+(?=_)|\S+') }}"
{%   if acl.ansible_facts.acl_extended_facts is defined %}
    type: extended
    version: {{ acl.ansible_facts.acl_extended_facts[0].version }}
    {% if ras_cfg is defined and (acl.item.item == loop_acl and ras_cfg == "deploy") -%}
    parents:
    children:
    {% endif -%}
    rules:
    
{%     for aces in acl.ansible_facts.acl_extended_facts %}
{%       if aces.remark is defined and aces.remark %}
      - line_no: "{{ aces.seq }}"
        remark: "{{ aces.remark | regex_replace('"','') }}"

{%     else %}
      - line_no: "{{ aces.seq }}"
        action: "{{ aces.action }}"
        service:
{%         if aces.protocol is defined and aces.protocol %}
          name: "{{ aces.protocol }}"
          type: protocol
{%         endif %}
{%         if aces.src_service_obj is defined and aces.src_service_obj %}
          name: "{{ aces.src_service_obj }}"
          type: svc_obj
{%         endif %}
{%         if aces.src_service_obj_grp is defined and aces.src_service_obj_grp %}
          name: "{{ aces.src_service_obj_grp }}"
          type: svc_obj_grp
{%         endif %}
        source:
{%         if aces.src_host is defined and aces.src_host %}
          name: "{{ aces.src_host }}"
          type: host
{%         endif %}
{%         if aces.src_network_obj is defined and aces.src_network_obj %}
          name: "{{ aces.src_network_obj }}"
          type: net_obj
{%         endif %}
{%         if aces.src_network_obj_grp is defined and aces.src_network_obj_grp %}
          name: "{{ aces.src_network_obj_grp }}"
          type: net_obj_grp
{%         endif %}
{%         if aces.src_network is defined and aces.src_network %}
          name: "{{ aces.src_network }}"
          type: network
{%         endif %}
        destination:
{%         if aces.dest_host is defined and aces.dest_host %}
          name: "{{ aces.dest_host }}"
          type: host
{%         endif %}
{%         if aces.dest_network_obj is defined and aces.dest_network_obj %}
          name: "{{ aces.dest_network_obj }}"
          type: net_obj
{%         endif %}
{%         if aces.dest_network_obj_grp is defined and aces.dest_network_obj_grp %}
          name: "{{ aces.dest_network_obj_grp }}"
          type: net_obj_grp
{%         endif %}
{%         if aces.dest_network is defined and aces.dest_network %}
          name: "{{ aces.dest_network }}"
          type: network
{%         endif %}
{%         if aces.dest_port is defined and aces.dest_port %}
        port:
          name: "{{ aces.dest_port }}"
          type: port
{%         endif %}
{%         if aces.dest_port_obj_grp is defined and aces.dest_port_obj_grp %}
        port:
          name: "{{ aces.dest_port_obj_grp }}"
          type: svc_obj_grp
{%         endif %}
{%         if aces.logging_level is defined and aces.logging_level %}
        logging:
          level: "{{ aces.logging_level }}"
          interval: "{{ aces.logging_interval }}"
{%         endif %}
        status: "{{ aces.status|default('active') }}"

{%       endif %}

{%   endfor -%}

{%   elif  acl.ansible_facts.acl_standard_facts is defined %}
    type: standard
    version: {{ acl.ansible_facts.acl_standard_facts[0].version }}
    rules:

{%     for aces in acl.ansible_facts.acl_standard_facts %}
{%       if aces.remark is defined and aces.remark %}
      - line_no: "{{ aces.seq }}"
        remark: "{{ aces.remark | regex_replace('"','') }}"
{%       else %}
      - line_no: "{{ aces.seq }}"
        action: "{{ aces.action }}"
        destination:
{%         if aces.dest_host is defined and aces.dest_host %}
          name: "{{ aces.dest_host }}"
          type: host
{%         endif %}
{%         if aces.dest_network is defined and aces.dest_network %}
          name: "{{ aces.dest_network }}"
          type: network
{%         endif %}
{%       endif %}
{%     endfor -%}
{%   endif %}
{% endif %}
{% endfor %}