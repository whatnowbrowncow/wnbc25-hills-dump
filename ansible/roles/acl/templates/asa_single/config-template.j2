{# ANY CHANGES TO THIS MAY AFFECT THE asa-ras-object ROLE, SO TESTING WITH BOTH ROLES IS NEEDED  #}
{% for item in access_lists %}
{%   for line in item.rules %}
{%     if item.type == "extended" %}
{%       if line.remark is defined %}
access-list {{ item.name }}{% if item.version is number %}_v{{ item.version }}{% endif %} remark {{ line.remark }}
{%       else %}
access-list {{item['name']}}{% if item.version is number %}_v{{ item.version }}{% endif %} {{item['type']}} {{ line.action }}{% if line.service.type == 'protocol' %} {{ line.service.name }}{% endif %}{% if line.service.type == 'svc_obj' %} object {{ line.service.name }}{% endif %}{% if line.service.type == 'svc_obj_grp' %} object-group {{ line.service.name }}{% endif %}{% if line.source.type == 'host' %} host {{ line.source.name }}{% endif %}{% if line.source.type == 'net_obj' %} object {{ line.source.name }}{% endif %}{% if line.source.type == 'net_obj_grp' %} object-group {{ line.source.name }}{% endif %}{% if line.source.type == 'network' %} {{ line.source.name }}{% endif %}{% if line.destination.type == 'host' %} host {{ line.destination.name }}{% endif %}{% if line.destination.type == 'net_obj' %} object {{ line.destination.name }}{% endif %}{% if line.destination.type == 'net_obj_grp' %} object-group {{ line.destination.name }}{% endif %}{% if line.destination.type == 'network' %} {{ line.destination.name }}{% endif %}{% if line.port is defined and line.port.type == 'port' %} eq {{ line.port.name }}{% elif line.port is defined and line.port.type == 'svc_obj_grp' %} object-group {{ line.port.name }}{% endif %}{% if line.logging is defined %}{% if line.logging.level == 'informational' %} log{% else %} log {{ line.logging.level }}{% endif %}{% if line.logging.interval != '300' %} interval {{ line.logging.interval }}{% endif %}{% if line.status != "active" %} inactive{% endif %}{% endif %}

{%       endif %}
{%     elif item.type == "standard" %}
{%       if line.remark is defined %}
access-list {{item['name']}}{% if item.version is number %}_v{{ item.version }}{% endif %} remark {{ line.remark }}
{%       else %}
access-list {{item['name']}}{% if item.version is number %}_v{{ item.version }}{% endif %} {{item['type']}} {{ line.action }}{% if line.destination.type == 'host' %} host {{ line.destination.name }}{% elif line.destination.type == 'network' %} {{ line.destination.name }}{% endif %}

{%       endif %}
{%     endif %}
{%   endfor %}
{%   if item.interface is defined %}
access-group {{ item.name }}{% if item.version is number %}_v{{ item.version }}{% endif %} {{ item.direction }} interface {{ item.interface }}
{%   endif %}
{% endfor %}
{% if ra_vpn_filters is defined %}
{%- for item in ra_vpn_filters -%}
group-policy {{ item.group_policy }} attributes
{% for acl in access_lists %}
{% if acl.name == item.ra_vpn_filter %}
    vpn-filter value {{ item.ra_vpn_filter }}{% if acl.version is number %}_v{{ acl.version }}{% endif %}

{% endif %}
{#{% if acl.name == item.split_tunnel_filter %}
    split-tunnel-network-list value {{ item.split_tunnel_filter }}{% if acl.version is number %}_v{{ acl.version }}{% endif %}

{% endif %} # This is to be deployed in the future #}
{% endfor %}
{% endfor %}
{% endif %}