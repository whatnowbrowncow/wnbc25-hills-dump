---

mgmt_interface:
{% if mgmt129_int_facts is defined %}  
  interface: "{{ mgmt129_int_facts[0].management_interface.interface }}"
  description: "{{ mgmt129_int_facts[0].management_interface.description }}"
  ip_addr: "{{ mgmt129_int_facts[0].management_interface.ip_address }}"
  cidr: "{{ mgmt129_int_facts[0].management_interface.cidr }}"
  vrf: "{{ mgmt129_int_facts[0].management_interface.vrf }}"
{% elif mgmt0_int_facts is defined %}
  interface: "{{ mgmt0_int_facts[0].management_interface.interface }}"
  description: "{{ mgmt0_int_facts[0].management_interface.description }}"
  ip_addr: "{{ mgmt0_int_facts[0].management_interface.ip_address }}"
  cidr: "{{ mgmt0_int_facts[0].management_interface.cidr }}"
  vrf: "{{ mgmt0_int_facts[0].management_interface.vrf }}"
{% elif loopbacks_facts.results[0].ansible_facts is defined %}
{% for item in loopbacks_facts.results %}
{% if item.ansible_facts is defined %}
{% if item.ansible_facts.loopback_int_facts[0].loopback_interface.interface == "Loopback20" %}
  interface: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.interface }}"
  description: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.description }}"
  ip_addr: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.ip_address }}"
  cidr: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.cidr }}"
  vrf: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.vrf }}"
{% else %}
{% endif %}
{% else %}
{% endif %}
{% endfor %}
{% elif vlan99_int_facts is defined %}
  interface: "{{ vlan99_int_facts[0].management_interface.interface }}"
  description: "{{ vlan99_int_facts[0].management_interface.description }}"
  ip_addr: "{{ vlan99_int_facts[0].management_interface.ip_address }}"
  cidr: "{{ vlan99_int_facts[0].management_interface.cidr }}"
  vrf: "{{ vlan99_int_facts[0].management_interface.vrf }}"
{% elif mgmt_tacacs_int_facts is defined %}
  interface: "{{ mgmt_tacacs_int_facts[0].management_interface.interface }}"
  description: "{{ mgmt_tacacs_int_facts[0].management_interface.description }}"
  ip_addr: "{{ mgmt_tacacs_int_facts[0].management_interface.ip_address }}"
  cidr: "{{ mgmt_tacacs_int_facts[0].management_interface.cidr }}"
  vrf: "{{ mgmt_tacacs_int_facts[0].management_interface.vrf }}"   
{% else %}
{% endif %}

loopback_interfaces:

{% if loopbacks_facts.results is defined %}
{% for item in loopbacks_facts.results %}
{% if item.ansible_facts is defined %}
  - interface: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.interface }}"
    description: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.description }}"
    ip_addr: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.ip_address }}"
    cidr: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.cidr }}"
    vrf: "{{ item.ansible_facts.loopback_int_facts[0].loopback_interface.vrf }}"

{% else %}
{% endif %}
{% endfor %}
{% endif %}
