{# ANY CHANGES TO THIS MAY AFFECT THE asa-ras-object ROLE, SO TESTING WITH BOTH ROLES IS NEEDED  #}
{% if network_object_groups is defined %}
{% for object_group in network_object_groups %}
{% if ras_exclusion is not defined or object_group.name not in ras_exclusion %}
object-group network {{ object_group.name }}
{% if object_group.description is defined %}
 description {{ object_group.description }}
{% else %}
{% endif %}
{% if object_group.objects is iterable %}
{% for object in object_group.objects %}
 network-object object {{ object.object_name }}
{% endfor %}
{% else %}
{% endif %}
{% if object_group.hosts is iterable %}
{% for host in object_group.hosts %}
 network-object host {{ host.ip_addr }}
{% endfor %}
{% else %}
{% endif %}
{% if object_group.networks is iterable %}
{% for network in object_group.networks %}
 network-object {{ network.ip_addr }} {{ network.mask }}
{% endfor %}
{% else %}
{% endif %}
{% if object_group.group_objects is iterable %}
{% for group in object_group.group_objects %}
 group-object {{ group.group_object_name }}
{% endfor %}
{% else %}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}